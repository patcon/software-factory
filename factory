#!/usr/bin/env bash
# Manage a remote GCP workstation for the software factory.
# Settings: factory.env (copy factory.env.example).
#
#   ./factory setup             check (and fix) this machine's setup; run first
#   ./factory create            VM + firewall, then writes the SSH config
#   ./factory provision [f...]  run provision/*.sh on the VM (all, in order)
#   ./factory ssh [cmd]         log in (or run a command)
#   ./factory herdr [args]      open herdr on the VM (herdr --remote)
#   ./factory start | stop      stop when idle: disk is kept, compute is free
#   ./factory status            VM state, access mode and addresses
#   ./factory issues            open issues labelled SF_FACTORY_LABEL, to hand
#                               to /factory-issue in pi
#   ./factory access            apply SF_ACCESS (ssh: open port 22 to your IP;
#                               tailscale: close port 22, use the tailnet)
#   ./factory allow-ip          open port 22 to your current IP (also the way
#                               back in if Tailscale breaks)
#   ./factory share [email]     invite someone to this VM over Tailscale, and
#                               print a message for them (needs TS_API_KEY);
#                               --world adds Herdr World's token, --for <id>
#                               redoes the message for an existing invite
#   ./factory ovis-code         a 10-minute Ovis pairing code for one device
#   ./factory shares            list invites, and who accepted them
#   ./factory unshare <id>      revoke an invite, and the access it gave
#   ./factory ssh-config        rewrite the SSH config
#   ./factory destroy           delete the VM, its disk and its firewall rules
set -euo pipefail

die() { echo "error: $*" >&2; exit 1; }
say() { echo "--- $*"; }

# shellcheck disable=SC1091
. "$(dirname "$0")/scripts/config.sh"
# shellcheck disable=SC1091
. "$SF_ROOT/scripts/checks.sh"

case "${1:-}" in
    setup) cmd_setup; exit ;;
    ""|help|-h|--help) ;;
    *) preflight ;;
esac

G=(gcloud --account="$SF_ACCOUNT" --project="$SF_PROJECT" --quiet)
ZONE=(--zone="$SF_ZONE")

exists()  { "${G[@]}" compute instances describe "$SF_NAME" "${ZONE[@]}" >/dev/null 2>&1; }
state()   { "${G[@]}" compute instances describe "$SF_NAME" "${ZONE[@]}" --format='value(status)' 2>/dev/null || echo MISSING; }
ip()      { "${G[@]}" compute instances describe "$SF_NAME" "${ZONE[@]}" \
              --format='value(networkInterfaces[0].accessConfigs[0].natIP)'; }
my_ip()   { curl -4 -fsS --max-time 10 https://checkip.amazonaws.com | tr -d '[:space:]'; }
rule_exists() { "${G[@]}" compute firewall-rules describe "$1" >/dev/null 2>&1; }

# The VM's tailnet IP, if this machine runs Tailscale and the VM has joined.
ts_ip() { command -v tailscale >/dev/null && tailscale ip -4 "$SF_NAME" 2>/dev/null; }

# The VM's full tailnet name (<name>.<tailnet>.ts.net), given its tailnet IP.
ts_dns() {
    local n; n="$(tailscale whois "$1" 2>/dev/null | awk '/^ *Name:/{print $2; exit}')"
    echo "${n%.}"
}

# Where to connect: the tailnet in tailscale mode once the VM has joined
# (before that, during bootstrap, the public IP).
target() {
    local t
    if [ "$SF_ACCESS" = tailscale ] && t="$(ts_ip)" && [ -n "$t" ]; then echo "$t"; else ip; fi
}

SSH_OPTS=(-o UserKnownHostsFile="$SF_KNOWN_HOSTS" -o HostKeyAlias="$SF_NAME" -o StrictHostKeyChecking=accept-new
          -o ConnectTimeout=10 -o BatchMode=yes)
ssh_vm() { ssh "${SSH_OPTS[@]}" "$SF_USER@$(target)" "$@"; }

# --- firewall ----------------------------------------------------------------
# The default network allows port 22 from anywhere (default-allow-ssh, priority
# 65534). A deny rule for this VM's tag at 1000 overrides it without touching
# other VMs. The allow rule at 900 beats the deny, for your IP only.

ensure_deny() {
    rule_exists "$SF_FW_DENY" && return 0
    say "firewall: blocking port 22 from the internet ($SF_FW_DENY)"
    "${G[@]}" compute firewall-rules create "$SF_FW_DENY" \
        --network=default --direction=INGRESS --action=DENY --rules=tcp:22 \
        --source-ranges=0.0.0.0/0 --target-tags="$SF_TAG" --priority=1000 >/dev/null
}

open_ssh() {
    ensure_deny
    local cidr; cidr="$(my_ip)/32"
    if rule_exists "$SF_FW_ALLOW"; then
        say "firewall: port 22 open to $cidr"
        "${G[@]}" compute firewall-rules update "$SF_FW_ALLOW" \
            --source-ranges="$cidr" --priority=900 >/dev/null
    else
        say "firewall: opening port 22 to $cidr ($SF_FW_ALLOW)"
        "${G[@]}" compute firewall-rules create "$SF_FW_ALLOW" \
            --network=default --direction=INGRESS --action=ALLOW --rules=tcp:22 \
            --source-ranges="$cidr" --target-tags="$SF_TAG" --priority=900 >/dev/null
    fi
}

close_ssh() {
    ensure_deny
    if rule_exists "$SF_FW_ALLOW"; then
        say "firewall: closing port 22 ($SF_FW_ALLOW)"
        "${G[@]}" compute firewall-rules delete "$SF_FW_ALLOW" >/dev/null
    fi
}

# --- commands ----------------------------------------------------------------

cmd_ssh_config() {
    local addr; addr="$(target)"
    [ -n "$addr" ] || die "$SF_NAME has no address (is it running?)"
    cat > "$SF_SSH_CONFIG" <<EOF
# Written by software-factory/factory ($SF_ACCESS access). Rewritten on
# create, start and access.
Host $SF_NAME
    HostName $addr
    User $SF_USER
    IdentityFile ${SF_PUBKEY%.pub}
    IdentitiesOnly yes
    UserKnownHostsFile $SF_KNOWN_HOSTS
    HostKeyAlias $SF_NAME
    StrictHostKeyChecking accept-new
    ServerAliveInterval 30
EOF
    say "wrote $SF_SSH_CONFIG ($SF_NAME -> $addr)"
    grep -qF "$SF_SSH_CONFIG" "$HOME/.ssh/config" 2>/dev/null \
        || echo "    add this line near the top of ~/.ssh/config:  Include $SF_SSH_CONFIG"
}

wait_for_ssh() {
    say "waiting for SSH ($(target))"
    for _ in $(seq 1 40); do
        ssh_vm true 2>/dev/null && return 0
        sleep 5
    done
    die "SSH did not come up; try ./factory allow-ip"
}

cmd_access() {
    if [ "$SF_ACCESS" = ssh ]; then
        open_ssh
    else
        local t; t="$(ts_ip)" || true
        [ -n "$t" ] || die "$SF_NAME is not on your tailnet yet: run ./factory provision 40-tailscale.sh (port 22 left as is)"
        ssh "${SSH_OPTS[@]}" "$SF_USER@$t" true \
            || die "cannot reach $SF_NAME over Tailscale at $t (port 22 left as is)"
        close_ssh
    fi
    cmd_ssh_config
}

cmd_create() {
    exists && die "$SF_NAME already exists ($(state))"
    [ -f "$SF_PUBKEY" ] || die "no public key at $SF_PUBKEY"
    # Even in tailscale mode the first login is over port 22: Tailscale is not
    # installed yet. `provision` closes it once the VM has joined the tailnet.
    open_ssh
    say "creating $SF_NAME ($SF_MACHINE_TYPE, ${SF_DISK_GB}GB) in $SF_ZONE"
    # No service account: nothing on the VM can act as you in GCP.
    # block-project-ssh-keys: only the key below gets in.
    "${G[@]}" compute instances create "$SF_NAME" "${ZONE[@]}" \
        --machine-type="$SF_MACHINE_TYPE" \
        --image-family="$SF_IMAGE_FAMILY" --image-project="$SF_IMAGE_PROJECT" \
        --boot-disk-size="${SF_DISK_GB}GB" --boot-disk-type=pd-balanced \
        --tags="$SF_TAG" --labels=managed-by=software-factory \
        --no-service-account --no-scopes \
        --metadata=block-project-ssh-keys=TRUE,enable-oslogin=FALSE,ssh-keys="$SF_USER:$(cat "$SF_PUBKEY")"
    : > "$SF_KNOWN_HOSTS"   # fresh VM, fresh host key
    cmd_ssh_config
    wait_for_ssh
    say "created. next: ./factory provision"
}

cmd_provision() {
    local files=("$@")
    [ ${#files[@]} -gt 0 ] || files=("$SF_ROOT"/provision/*.sh)
    # Config files the scripts install (pi/ -> ~/.factory/pi), replaced whole.
    say "provision: copying pi/ to ~/.factory/pi"
    tar -C "$SF_ROOT" -cf - pi | ssh_vm 'rm -rf ~/.factory/pi && mkdir -p ~/.factory && tar -C ~/.factory -xf -'
    for f in "${files[@]}"; do
        [ -f "$f" ] || f="$SF_ROOT/provision/$f"
        [ -f "$f" ] || die "no such provision script: $f"
        say "provision: $(basename "$f")"
        # Secrets from factory.env ride in on stdin, never on a command line.
        { [ -z "${TS_AUTHKEY:-}" ] || printf 'export TS_AUTHKEY=%q\n' "$TS_AUTHKEY"
          [ -z "${SF_GH_TOKEN:-}" ] || printf 'export SF_GH_TOKEN=%q\n' "$SF_GH_TOKEN"
          printf 'export SF_OVIS_TELEMETRY=%q\n' "$SF_OVIS_TELEMETRY"
          printf 'export %s=%q\n' SF_GH_NAME "$SF_GH_NAME" SF_GH_EMAIL "$SF_GH_EMAIL" \
              SF_FACTORY_REPOS "$SF_FACTORY_REPOS" SF_FACTORY_LABEL "$SF_FACTORY_LABEL"
          cat "$f"; } | ssh_vm 'bash -s'
    done
    say "provisioned"
    # Tailscale mode: now that the VM may have joined, close port 22.
    if [ "$SF_ACCESS" = tailscale ] && rule_exists "$SF_FW_ALLOW"; then
        cmd_access
    fi
}

cmd_start() {
    say "starting $SF_NAME"
    "${G[@]}" compute instances start "$SF_NAME" "${ZONE[@]}"
    [ "$SF_ACCESS" = ssh ] && open_ssh
    cmd_ssh_config
    wait_for_ssh
}

cmd_stop() {
    say "stopping $SF_NAME"
    "${G[@]}" compute instances stop "$SF_NAME" "${ZONE[@]}"
}

# show_app <title> <link to print> <link in the QR>
show_app() {
    echo
    echo "$1"
    echo "  $2"
    if command -v qrencode >/dev/null; then
        qrencode -t UTF8i -m 2 "$3" | sed 's/^/  /'
    else
        echo "  (brew install qrencode, or apt install qrencode, for a QR code here)"
    fi
}

cmd_status() {
    local s; s="$(state)"
    echo "$SF_NAME: $s"
    echo "access: $SF_ACCESS"
    if rule_exists "$SF_FW_ALLOW"; then
        echo "port 22: open to $("${G[@]}" compute firewall-rules describe "$SF_FW_ALLOW" --format='value(sourceRanges.list())')"
    else
        echo "port 22: closed"
    fi
    [ "$s" = RUNNING ] && echo "public ip: $(ip)"
    local t; t="$(ts_ip)" || true
    [ -n "$t" ] || return 0
    echo "tailnet ip: $t"
    local tn; tn="$(ts_dns "$t")"
    [ -n "$tn" ] || return 0

    # Apps on the tailnet, each shown only when it answers, with a QR for a phone.
    # Home page linking the rest (85-home.sh).
    local home="https://$tn/"
    if curl -fs --max-time 5 -o /dev/null "$home"; then
        show_app "Home (links to the apps)" "$home" "$home"
    fi
    # Ovis (70-ovis.sh).
    local ovis="https://$tn:8443/"
    if curl -fs --max-time 5 -o /dev/null "${ovis}api/health"; then
        show_app "Ovis (Herdr UI)" "$ovis" "$ovis"
    fi
    # Herdr World (80-herdr-world.sh). It always wants a login, so the QR
    # carries the token: one scan per browser, then a session cookie keeps you
    # in. The printed link hides it; the QR is as secret as the token.
    local world="https://$tn:9443/"
    if curl -fs --max-time 5 -o /dev/null "${world}healthz"; then
        local tok; tok="$(ssh_vm 'cat ~/.config/herdr-world/auth-token' 2>/dev/null)" || true
        if [ -n "$tok" ]; then
            show_app "Herdr World" "${world}?token=<secret>" "${world}?token=$tok"
            echo "  (<secret>: ssh $SF_NAME cat .config/herdr-world/auth-token; the QR includes it)"
        else
            show_app "Herdr World" "$world" "$world"
        fi
    fi
    # T3 Code (75-t3code.sh). Pairing is per device, so no secret in the QR.
    local t3="https://$tn:10000/"
    if curl -fs --max-time 5 -o /dev/null "$t3"; then
        show_app "T3 Code" "$t3" "$t3"
        echo "  (new device: ssh $SF_NAME '~/.local/bin/t3 pair --tailscale --tailscale-serve-port 10000')"
    fi
    # T3 Office (77-t3-office.sh).
    local office="https://$tn:10001/"
    if curl -fs --max-time 5 -o /dev/null "$office"; then
        show_app "T3 Office" "$office" "$office"
    fi
    return 0
}

cmd_herdr() {
    local msg
    msg="$(check_herdr)" || die "$msg"
    msg="$(check_include)" || die "$msg"
    [ "$(state)" = RUNNING ] || die "$SF_NAME is not running: ./factory start"
    # herdr wants matching versions on both ends; say so before it fails.
    local here there
    here="$(herdr --version | awk '{print $2}')"
    there="$(ssh_vm '"$HOME/.local/bin/herdr" --version' 2>/dev/null | awk '{print $2}')" || true
    if [ -z "$there" ]; then
        echo "! herdr isn't on $SF_NAME: ./factory provision 20-herdr.sh" >&2
    elif [ "$here" != "$there" ]; then
        echo "! herdr $here here, $there on $SF_NAME: herdr update (or brew upgrade herdr if installed by brew)" >&2
    fi
    exec herdr --remote "$SF_NAME" "$@"
}

cmd_issues() {
    [ -n "$SF_FACTORY_REPOS" ] || die "set SF_FACTORY_REPOS in factory.env"
    local r
    for r in $SF_FACTORY_REPOS; do
        echo "$r ($SF_FACTORY_LABEL):"
        ssh_vm "gh issue list -R $(printf %q "$r") --state open --label $(printf %q "$SF_FACTORY_LABEL")" | sed 's/^/  /'
    done
    echo
    echo "to take one: in a herdr pane, cd ~/work/<owner>/<repo> && pi, then /factory-issue <number>"
}

# --- sharing -----------------------------------------------------------------
# Tailscale "machine sharing": the guest accepts into their own tailnet and
# reaches this VM only (not the rest of yours), under your tailnet policy.

# ts_api METHOD PATH [JSON]. The token goes to curl in a header file (a
# process substitution), never on its command line.
ts_api() {
    [ -n "${TS_API_KEY:-}" ] || die "set TS_API_KEY in factory.env (how: factory.env.example)"
    local args=(-sS --fail-with-body --max-time 20 -X "$1"
                -H @<(printf 'Authorization: Bearer %s\n' "$TS_API_KEY"))
    [ $# -lt 3 ] || args+=(-H 'Content-Type: application/json' --data "$3")
    local out msg
    if ! out="$(curl "${args[@]}" "https://api.tailscale.com/api/v2$2" 2>/dev/null)"; then
        msg="$(jq -r '.message // empty' <<<"$out" 2>/dev/null || true)"
        die "Tailscale API, $1 $2: ${msg:-no answer (network, or token missing a permission)}"
    fi
    printf '%s\n' "$out"
}

# The VM's stable node ID (nXXXXCNTRL), which the API takes as a device ID.
ts_node_id() {
    local t id
    t="$(ts_ip)" || true
    [ -n "$t" ] || die "$SF_NAME is not on your tailnet (or Tailscale isn't running here)"
    id="$(tailscale status --json 2>/dev/null | jq -r --arg ip "$t" '.Peer[] | select(.TailscaleIPs | index($ip)) | .ID')"
    [ -n "$id" ] || die "can't find $SF_NAME's node ID in tailscale status"
    echo "$id"
}

# A guest's T3 Code pairing is labelled share-<invite id>, so unshare can find
# it. Read-only (orchestration:read), and as long as an unused invite lasts.
T3_GUEST_SCOPE=orchestration:read
T3_GUEST_TTL=30d

# t3_guest_pair <label> <tailnet name>: prints a new T3 Code pairing link.
# Earlier links for the label stay valid (one may already be sent); unshare
# revokes them all. Fails if T3 Code isn't on the VM.
t3_guest_pair() {
    ssh_vm bash -s -- "$1" "$2" "$T3_GUEST_SCOPE" "$T3_GUEST_TTL" <<'EOS' | jq -re .pairUrl
export PATH="$HOME/.local/bin:$PATH"
command -v t3 >/dev/null || exit 3
t3 auth pairing create --scope "$3" --ttl "$4" --label "$1" --base-url "https://$2:10000" --json
EOS
}

# t3_guest_revoke <label>: revokes that label's unused pairing links and the
# T3 Code sessions they started. Prints how many of each.
t3_guest_revoke() {
    ssh_vm bash -s -- "$1" <<'EOS'
export PATH="$HOME/.local/bin:$PATH"
command -v t3 >/dev/null || { echo "0 0"; exit 0; }
p=0 s=0
for id in $(t3 auth pairing list --json | jq -r --arg l "$1" '.[] | select(.label == $l) | .id'); do
    t3 auth pairing revoke "$id" >/dev/null && p=$((p + 1))
done
for id in $(t3 auth session list --json | jq -r --arg l "$1" '.[] | select(.client.label == $l) | .sessionId'); do
    t3 auth session revoke "$id" >/dev/null && s=$((s + 1))
done
echo "$p $s"
EOS
}

# ./factory share [email] [--world] [--for <invite id>]
# The message for the guest goes to stdout (./factory share > invite.txt);
# notes for you go to stderr.
cmd_share() {
    local email="" world="" for_id="" out id invite tn tip t3url wurl
    while [ $# -gt 0 ]; do
        case "$1" in
            --world) world=1 ;;
            --for)   for_id="${2:-}"; shift
                     [[ "$for_id" =~ ^[A-Za-z0-9-]+$ ]] || die "usage: ./factory share --for <invite id>" ;;
            -*)      die "unknown option: $1" ;;
            *)       email="$1" ;;
        esac
        shift
    done
    if [ -n "$for_id" ]; then
        out="$(ts_api GET "/device-invites/$for_id")"
        out="[$out]"
    else
        out="$(ts_api POST "/device/$(ts_node_id)/device-invites" \
            "$(jq -nc --arg e "$email" '[{multiUse: false, allowExitNode: false} + (if $e == "" then {} else {email: $e} end)]')")"
    fi
    id="$(jq -r '.[0].id' <<<"$out")"
    email="$(jq -r '.[0].email // empty' <<<"$out")"
    invite="$(jq -r '.[0].inviteUrl // empty' <<<"$out")"
    tip="$(ts_ip)"
    tn="$(ts_dns "$tip")"
    t3url="$(t3_guest_pair "share-$id" "$tn")" || t3url=""
    if [ -n "$world" ]; then
        wurl="https://$tn:9443/?token=$(ssh_vm 'cat ~/.config/herdr-world/auth-token')"
    fi

    {
        echo "invite $id$( [ -n "$email" ] && echo ", emailed to $email" )"
        [ -n "$t3url" ] || echo "! no T3 Code link: T3 Code isn't on $SF_NAME, or pairing failed"
        [ -z "$world" ] || echo "! the message has Herdr World's token: full control of herdr, as you. Take it back: ./factory ssh, herdr-world auth rotate (signs you out too)"
        echo "Ovis, when they ask: ./factory ovis-code (10 minutes, one device), then set"
        echo "  their device to watch in Ovis, Settings -> Devices (pairing gives drive)"
        echo "revoke all of it: ./factory unshare $id"
        echo "--- message for them below ---"
        echo
    } >&2

    echo "You're invited to $SF_NAME, a dev machine shared with you over Tailscale."
    echo
    if [ -n "$email" ] && [ -z "$for_id" ]; then
        echo "1. Accept the invite Tailscale emailed to $email."
    else
        echo "1. Accept the invite: ${invite:-<the link Tailscale emailed you>}"
    fi
    cat <<EOT
   Sign in with any Tailscale account (a free personal one is fine). This
   adds only this one machine to your tailnet, and you can remove it any time.

2. Turn on MagicDNS in your Tailscale admin console, under DNS:
   https://login.tailscale.com/admin/dns
   If you'd rather not, add this line to your hosts file instead
   (/etc/hosts, or C:\\Windows\\System32\\drivers\\etc\\hosts):
     $tip  $tn
   (If \`tailscale status\` shows $SF_NAME at another address, use that.)

3. Open https://$tn/
   It links to everything; a green dot means you can reach it.
   - T3 Office, a live view of the agents' threads: no login needed
EOT
    if [ -n "$t3url" ]; then
        echo "   - T3 Code, read only: open this link once to sign in"
        echo "     $t3url"
        echo "     (one browser, use it within 30 days; keep it to yourself)"
    fi
    if [ -n "$world" ]; then
        echo "   - Herdr World: open this link once to sign in"
        echo "     $wurl"
        echo "     (keep it to yourself: it signs in anyone who has it)"
    fi
    echo "   - Ovis: ask me for a code when you're ready; it lasts 10 minutes"
}

# Ovis's own `pair` (installed as a herdr plugin, so there's no `ovis`
# command): prints a code, the address and a QR code with the code in it.
cmd_ovis_code() {
    ssh_vm 'export PATH="$HOME/.local/bin:$HOME/.bun/bin:$PATH"
        root="$(herdr plugin list --json | jq -r ".result.plugins[] | select(.plugin_id == \"devswha.ovis\") | .plugin_root")"
        [ -n "$root" ] || { echo "Ovis is not installed: ./factory provision 70-ovis.sh" >&2; exit 1; }
        cd "$root" && bun scripts/plugin.ts pair'
    echo "a new device pairs with drive (it can type): make it watch in Ovis, Settings -> Devices"
}

cmd_shares() {
    local out
    out="$(ts_api GET "/device/$(ts_node_id)/device-invites")"
    jq -r <<<"$out" '
        if length == 0 then "no invites" else
        (["ID", "STATUS", "SENT TO / LINK"] | @tsv),
        (.[] | [.id,
                (if .accepted then "accepted by \(.acceptedBy.loginName)" else "pending" end),
                (.email // .inviteUrl // "")] | @tsv) end' | column -t -s $'\t'
}

cmd_unshare() {
    [ -n "${1:-}" ] || die "usage: ./factory unshare <id>   (./factory shares lists them)"
    [[ "$1" =~ ^[A-Za-z0-9-]+$ ]] || die "not an invite id: $1"
    ts_api DELETE "/device-invites/$1" >/dev/null
    say "revoked invite $1: whoever accepted it can no longer reach $SF_NAME"
    local n
    if n="$(t3_guest_revoke "share-$1")"; then
        read -r p s <<<"$n"
        [ "$p$s" = 00 ] || say "T3 Code: revoked $p unused pairing link(s) and $s session(s)"
    else
        echo "! couldn't reach $SF_NAME to revoke T3 Code pairing share-$1: ./factory ssh, then t3 auth pairing list / session list" >&2
    fi
}

cmd_destroy() {
    exists || die "$SF_NAME does not exist"
    read -r -p "Delete $SF_NAME, its disk and firewall rules? Type the name to confirm: " ans
    [ "$ans" = "$SF_NAME" ] || die "not confirmed"
    "${G[@]}" compute instances delete "$SF_NAME" "${ZONE[@]}" --delete-disks=all
    for r in "$SF_FW_ALLOW" "$SF_FW_DENY"; do
        rule_exists "$r" && "${G[@]}" compute firewall-rules delete "$r" >/dev/null
    done
    rm -f "$SF_KNOWN_HOSTS" "$SF_SSH_CONFIG"
    say "deleted"
    [ -n "$(ts_ip || true)" ] && echo "    also remove $SF_NAME from your tailnet: https://login.tailscale.com/admin/machines"
    return 0
}

case "${1:-}" in
    create)     cmd_create ;;
    provision)  shift; cmd_provision "$@" ;;
    herdr)      shift; cmd_herdr "$@" ;;
    ssh)        shift; ssh -t "${SSH_OPTS[@]/BatchMode=yes/BatchMode=no}" "$SF_USER@$(target)" "$@" ;;
    start)      cmd_start ;;
    stop)       cmd_stop ;;
    status)     cmd_status ;;
    issues)     cmd_issues ;;
    access)     cmd_access ;;
    allow-ip)   open_ssh
                [ "$SF_ACCESS" = tailscale ] && echo "    temporary: ./factory access closes it again"
                true ;;
    share)      shift; cmd_share "$@" ;;
    ovis-code)  cmd_ovis_code ;;
    shares)     cmd_shares ;;
    unshare)    shift; cmd_unshare "$@" ;;
    ssh-config) cmd_ssh_config ;;
    destroy)    cmd_destroy ;;
    *) sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
